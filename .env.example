# Notion Integration Token (create at https://www.notion.so/my-integrations)
NOTION_TOKEN="ntn_your_notion_integration_token_here"

# Notion Database ID for syncing job prospects (32-char UUID from database URL)
NOTION_DATABASE_ID="00000000-0000-0000-0000-000000000000"

# Optional: ntfy push notification endpoint (https://ntfy.sh or self-hosted)
NOTIFY_URL="https://ntfy.sh/your-private-job-search-topic"
