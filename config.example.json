  "location": {
    "allow_remote": true,
    "local_display_name": "Your Metro Area, ST",
    "local_metro_patterns": [
      "your city",
      "nearby suburb 1",
      "nearby suburb 2"
    ],
    "local_metro_exclude_patterns": [
      "same city name,\\s*(?:other_state)"
