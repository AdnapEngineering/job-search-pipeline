    "local_state_only_pattern": "^\\W*(?:your_state_abbr|your_state_name)(?:\\W+(?:us|usa|united states(?: of america)?))?\\W*$",
    "jd_local_metro_pattern": "\\b(your city,? (?:st|state_name)\\b|nearby suburb 1|nearby suburb 2)",
    "home_states": [],
    "home_timezones": [],
    "allowed_country_pattern": "\\b(us|united states|usa)\\b",
    "country_token_pattern": "(?:US|USA|U\\.S\\.A?\\.?|United States|continental U\\.?S\\.?)",
    "global_eligible_pattern": "\\b(worldwide|anywhere|global|north america|northern america|americas)\\b",
    "foreign_exclude_patterns": [
      "\\bcanada\\b",
      "\\buk\\b",
