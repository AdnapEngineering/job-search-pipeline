  "compensation": {
    "min_salary": 100000,
    "pay_midpoint_max_cap": 120000,
    "pay_midpoint_penalty": 10,
    "pay_floor_taper_from": 0
  },
  "experience": {
    "max_min_yoe": 7,
    "max_min_secondary_yoe": 3,
    "secondary_yoe_context_pattern": "secondary_specialty_1|secondary_specialty_2",
    "primary_yoe_context_pattern": "primary_specialty_1|primary_specialty_2",
    "yoe_field_terms_pattern": "(?:engineering|development|analytics|design|management|operations|professional)",
    "max_senior_role_years": 3,
    "top_yoe_penalty": 10,
    "reject_clearance": true,
    "clearance_ignore_terms": [],
    "reject_foreign_language_req": true
  },
  "titles": {
    "target_patterns": [
      "\\banalyst\\b",
      "\\bengineer\\b",
      "\\bspecialist\\b",
      "\\bmanager\\b"
    ],
    "strong_target_patterns": [
      "target role 1",
      "target role 2",
      "core specialty"
    ],
    "primary_role_groups": [
      {
        "label": "Primary Target Role",
        "pattern": "\\b(target role 1|target role 2)\\b",
        "points": 20
      }
    ],
    "primary_role_patterns": [
      "target role 1",
      "core specialty"
    ],
    "generic_role_patterns": [
      "specialist",
      "analyst",
      "engineer"
    ],
    "generic_role_required_skills": [
      "core_skill_1",
      "core_skill_2"
    ],
    "generic_body_signal_patterns": [
      "\\b(target responsibility 1|target responsibility 2)\\b",
      "end[- ]to[- ]end"
    ],
    "generic_body_signal_min": 2,
    "exclude_seniority_patterns": [
      "staff",
      "principal",
      "director",
      "vp",
      "head",
      "intern",
      "entry level",
      "junior"
    ],
    "exclude_tech_patterns": [
      "\\bunwanted_tool_1\\b",
      "\\bunwanted_tool_2\\b"
    ],
    "exclude_role_patterns": [
      "\\bintern\\b",
      "\\bco-op\\b",
      "\\bcontract\\b",
      "\\bc2c\\b",
      "\\bcorp[- ]to[- ]corp\\b",
      "\\bearly[- ]career\\b",
      "\\bentry[- ]level\\b",
      "\\bunrelated_department_1\\b",
      "\\bunrelated_department_2\\b"
    ],
    "soft_exclude_role_patterns": [
      "\\bunrelated_department_1\\b"
    ],
    "bad_role_patterns": [
      "unrelated role 1",
      "unrelated role 2"
    ],
    "soft_bad_role_patterns": [
      "adjacent role only valid with strong title"
    ],
    "hn_role_pattern": "\\b((?:senior |sr\\.? )?(?:target role 1|target role 2|specialist|engineer|analyst))\\b"
  },
  "companies": {
    "exclude_companies": [
      "excluded_company_1",
      "excluded_company_2"
    ],
    "exclude_recruiters": [
      "staffing",
      "recruit\\w*",
      "talent\\w*",
