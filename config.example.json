      "hays"
    ],
    "allow_recruiters": [],
    "company_aliases": {
      "exampleparentcorp": "examplebrand"
    }
  },
  "skills_and_scoring": {
    "base_score": 20,
    "core_strength_points": 5,
    "core_strengths_cap": 40,
    "domain_score_cap": 20,
    "strong_floor": 75,
    "secondary_floor": 55,
    "min_sync_score": 80,
    "min_review_score": 55,
    "detect_stack_keywords": [
      "Core_Skill_1",
      "Core_Skill_2",
      "Core_Skill_3",
      "Tool_A",
      "Tool_B"
    ],
    "core_strengths": [
      "core_skill_1",
      "core_skill_2",
      "core_skill_3",
      "tool_a",
      "tool_b"
    ],
    "focus_keywords": {
      "high_priority_domain_1": 15,
      "high_priority_domain_2": 15,
      "medium_priority_competency_1": 10,
      "medium_priority_competency_2": 10,
      "bonus_topic_1": 5
    },
    "hard_exclude_skills": [
      "incompatible_skill_1",
      "incompatible_skill_2"
    ],
    "accepted_alternative_skills": [
      "core_skill_1",
      "core_skill_2"
    ],
    "soft_skill_penalty": 5,
    "avoid_keywords": [
      "legacy_system_1",
      "legacy_system_2"
    ],
    "penalized_keywords": {
      "secondary_tool_with_minor_penalty": 5
    },
    "conditional_require_any": {
      "if_present": [
        "secondary_tool_with_minor_penalty"
      ],
      "require_any_of": [
        "core_skill_1"
      ]
    },
    "hard_ask_penalties": [
      {
        "label": "Stretch certification/skill asked",
        "pattern": "\\b(stretch_skill_1|stretch_skill_2)\\b",
        "penalty": 10,
        "ignore_multi_level": false
      },
      {
        "label": "People/team leadership asked",
        "pattern": "\\b(team lead(?:ership)?|lead(?:ing)? (?:a )?(?:small )?teams?)\\b",
        "penalty": 10,
        "ignore_multi_level": true
      }
    ],
    "specialty_reject_rules": [
      {
        "title_pattern": "\\b(off_target_specialty_1|off_target_specialty_2)\\b",
        "jd_yoe_pattern": "\\b\\d{1,2}\\s*\\+?\\s*(?:years|yrs)\\b[^.\\n]{0,50}\\b(off_target_specialty_1)\\b",
        "jd_term_pattern": "\\b(off_target_specialty_1|off_target_specialty_2)\\b",
        "min_mentions": 3
      }
    ],
    "off_center_role_check": {
      "role_statement_pattern": "\\b(?:as an?|you(?:'ll| will) (?:be|join as) an?)\\s+(?:senior |staff |principal )?off[- ]target role",
      "off_center_words_pattern": "\\b(off_target_keyword_1|off_target_keyword_2|off_target_keyword_3)\\b",
      "target_words_pattern": "\\b(core_skill_1|core_skill_2|target_domain_1)\\b",
      "min_mentions": 6,
      "ratio": 1.5
    }
  },
  "scraper": {
    "concurrency": 15
  },
  "llm_review": {
    "provider": "agy",
    "model": "gemini-4-hydrogen-medium",
    "agy_path": "~/.local/bin/agy",
    "timeout_seconds": 180,
    "workers": 3,
    "jd_chars": 9000,
    "jd_head_chars": 2500,
    "review_version": "1",
    "repost_similarity": 0.8,
    "budget": {
      "max_reviews_per_run": 0,
      "max_tokens_per_run": 0,
      "max_tokens_per_day": 0,
      "max_usd_per_run": 0,
      "max_usd_per_day": 0
    },
    "pricing": {
      "openai": {
        "input_per_mtok": null,
        "cached_input_per_mtok": null,
        "output_per_mtok": null
      }
    },
    "components": {
      "hard_reqs": 4,
      "core_work": 3,
      "evidence": 3,
      "level": 2
    },
    "blocker_cap": 30,
    "level_mismatch_cap": 65,
    "apply_min_score": 80,
    "stretch_min_score": 50,
    "quote_match_ratio": 0.85,
    "rubric_descriptions": {
      "hard_reqs": "4 = every hard requirement met; 3 = met, with only soft gaps; 2 = one bounded hard gap (one named tool/skill or years 1 over); 1 = several hard gaps; 0 = a clear blocker (years far over, a required specialty/credential the candidate lacks).",
      "core_work": "3 = directly matches the candidate's primary target role and day-to-day responsibilities; 2 = balanced/adjacent role in the candidate's core domain; 1 = peripheral overlap; 0 = off-target specialty.",
      "evidence": "3 = the posting itself asks for work that mirrors a specific accomplishment in the candidate profile; 2 = strong skill and domain overlap; 1 = partial overlap; 0 = little overlap. Grade only what the posting says, not what the company is known for.",
      "level": "2 = matches the candidate's target seniority/level range; 1 = slight stretch in seniority or pay band mismatch; 0 = under-leveled or over-leveled."
    },
    "calibration_examples": [
      "Example Co A, Senior Target Role: asks 4+ years; core domain work that directly mirrors candidate's primary accomplishment. hard 4, core 3, evidence 3, level 2 [100%].",
      "Example Co B, Mid-level Target Role: 3+ years on core skill stack; exact tools at the candidate's target level. hard 4, core 3, evidence 2, level 2 [92%].",
      "Example Co C, Off-Target Role: asks 8+ years in an unrelated specialty. hard 0, core 1, evidence 1, level 1 [30%, blocker]."
    ]
  },
  "notion": {
    "notion_version": "2022-06-28",
